{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/radz2291/GRID-RIFT/contracts/experiment.schema.json",
  "title": "GRID-RIFT experiment specification v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "id", "version", "title", "status", "seed", "timing", "teams", "participants", "modules", "evaluation", "presentation"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "0.1.0"},
    "apiVersion": {"const": "grid-rift/v0"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "status": {"enum": ["draft", "frozen"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["tickRateHz", "maxTicks", "hashEveryTicks", "snapshotEveryTicks", "maxCommandLeadTicks", "maxCommandAgeTicks"],
      "properties": {
        "tickRateHz": {"type": "integer", "minimum": 1, "maximum": 240},
        "maxTicks": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "hashEveryTicks": {"type": "integer", "minimum": 1},
        "snapshotEveryTicks": {"type": "integer", "minimum": 1},
        "maxCommandLeadTicks": {"type": "integer", "minimum": 1},
        "maxCommandAgeTicks": {"type": "integer", "minimum": 1}
      }
    },
    "teams": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}}},
    "participants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/participant"}},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "metrics", "storage", "recordInputs", "recordEvents"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"},
        "metrics": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "storage": {"const": "local-only"}, "recordInputs": {"type": "boolean"}, "recordEvents": {"type": "boolean"}
      }
    },
    "presentation": {
      "type": "object", "additionalProperties": false,
      "required": ["theme", "camera", "view"],
      "properties": {
        "theme": {"$ref": "#/$defs/id"}, "camera": {"$ref": "#/$defs/id"},
        "view": {"enum": ["controller", "headless"]}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "controller": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "policyId", "policyVersion", "decisionIntervalTicks", "reactionTicks", "actionLimitPerTick"],
      "properties": {
        "kind": {"enum": ["human", "local-policy"]},
        "policyId": {"$ref": "#/$defs/id"}, "policyVersion": {"$ref": "#/$defs/version"},
        "decisionIntervalTicks": {"type": "integer", "minimum": 1},
        "reactionTicks": {"type": "integer", "minimum": 0},
        "actionLimitPerTick": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "teamId", "archetypeId", "controller"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "teamId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "archetypeId": {"$ref": "#/$defs/id"}, "controller": {"$ref": "#/$defs/controller"}
      }
    },
    "module": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "config"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "config": {"type": "object"}}
    }
  }
}
